{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexeyPlatkovsky/agent-manifest/blob/main/contracts/instruction-evaluation.schema.json",
  "title": "Instruction evaluation",
  "description": "Structured result returned by the instruction-evaluator agent.",
  "x-framework-version": "3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "scope",
    "findings",
    "unverified"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "accept",
        "accept-with-notes",
        "revise"
      ]
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "unverified": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "artifact",
        "issue",
        "recommendation"
      ],
      "properties": {
        "severity": {
          "enum": [
            "blocking",
            "major",
            "minor",
            "info"
          ]
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "issue": {
          "type": "string",
          "minLength": 1
        },
        "recommendation": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
