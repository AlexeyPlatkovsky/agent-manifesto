{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/AlexeyPlatkovsky/agent-manifest/blob/main/contracts/workflow.schema.json",
  "title": "Agent Manifesto workflow",
  "description": "Data shape for a declarative soft-harness workflow.",
  "x-framework-version": "3.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "description",
    "applies_when",
    "steps"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^3\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "applies_when": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8
      }
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "goal",
        "on_failure"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "goal": {
          "type": "string",
          "minLength": 8
        },
        "needs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "skills": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "agent": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "when": {
          "type": "string",
          "minLength": 8
        },
        "for_each": {
          "type": "string",
          "minLength": 8
        },
        "retries": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "approval": {
          "enum": [
            "required"
          ]
        },
        "input_contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "output_contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "on_failure": {
          "enum": [
            "stop",
            "ask_user",
            "continue"
          ]
        }
      }
    }
  }
}